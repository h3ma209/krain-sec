        "y": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "krain-mysql"
      },
      "targets": [
        {
          "rawSql": "SELECT\n  $__timeGroup(created_at, $__interval) AS time,\n  SUM(success = 1) AS success,\n  SUM(success = 0) AS failed\nFROM auth_attempts\nWHERE $__timeFilter(created_at)\nGROUP BY time\nORDER BY time",
          "format": "time_series",
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
