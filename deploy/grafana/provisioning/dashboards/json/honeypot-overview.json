    {
      "type": "timeseries",
      "title": "HTTP requests over time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "krain-mysql"
      },
      "targets": [
        {
          "rawSql": "SELECT\n  $__timeGroup(created_at, $__interval) AS time,\n  COUNT(*) AS requests\nFROM http_requests\nWHERE $__timeFilter(created_at)\nGROUP BY time\nORDER BY time",
          "format": "time_series",
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "mysql",
            "uid": "krain-mysql"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Auth attempts over time",
      "gridPos": {
        "h": 8,
        "w": 12,
