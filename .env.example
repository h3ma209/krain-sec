# Public base for canary links inside planted files / PDFs (set to real bait URL)
HONEYTOKEN_BASE_URL=http://127.0.0.1:8080

# Structured logs (JSON slog to stdout + app-*.jsonl) and attack events (auth/http/ssh JSONL).
# Compose mounts ./logs → /app/logs
LOG_DIR=logs
# Delete log files older than this many days (mtime)
LOG_RETENTION_DAYS=7
# Operational log level: debug | info | warn | error
LOG_LEVEL=info

# Optional: set a stable JWT secret (otherwise random per process start)
# JWT_SECRET=

# Max in-flight HTTP requests (extra get 503)
MAX_HTTP_INFLIGHT=64
# Max concurrent MySQL decoy tarpit handlers (extra conns closed)
MAX_MYSQL_DECOY=16
# Max concurrent SSH decoy shells (extra get kicked after auth)
MAX_SSH_SESSIONS=32

# HTTP rate limits (requests per minute, per client IP)
RATE_LIMIT_RPM=40
RATE_LIMIT_LOGIN_RPM=8
RATE_LIMIT_TRAP_RPM=20
RATE_LIMIT_TELEMETRY_RPM=60
